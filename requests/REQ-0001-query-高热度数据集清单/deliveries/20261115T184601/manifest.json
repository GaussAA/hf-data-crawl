  "sql": "SELECT \"id\", \"url\", \"author\", \"created_at\", \"last_modified\", \"description\", \"downloads\", \"downloads_all_time\", \"likes\", \"status\", \"gated\", \"license_name\", \"licenses\", CASE WHEN coalesce(array_length(\"languages\"), 0) > 0 THEN \"languages\" ELSE \"card_languages\" END AS \"languages\", \"modalities\", CASE WHEN coalesce(array_length(\"task_categories\"), 0) > 0 THEN \"task_categories\" ELSE \"card_task_categories\" END AS \"task_categories\", \"formats\", \"libraries\", \"tags\", CASE WHEN coalesce(array_length(\"plain_tags\"), 0) > 0 THEN \"plain_tags\" ELSE \"card_tags\" END AS \"plain_tags\", \"pretty_name\", \"multilinguality\", \"arxiv_ids\", \"source_datasets\", \"task_ids\", CASE WHEN coalesce(array_length(\"size_categories\"), 0) > 0 THEN \"size_categories\" ELSE \"card_size_categories\" END AS \"size_categories\", \"server_num_rows\", \"server_num_columns\", \"server_config_count\", \"main_size\", \"server_num_bytes_parquet\"\nFROM datasets\nWHERE \"downloads\" > 1000\n  AND \"likes\" > 1000\nORDER BY \"downloads\" DESC, \"id\" ASC",
