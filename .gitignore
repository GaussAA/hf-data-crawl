# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 采集产物（数据不入库）
data/
runs/

# 临时探查脚本与中间产物
.scratch/

# 交付档案只把「话」入库：manifest.json / README.md 可评审、可追溯；产物字节
# 留在本机，由 manifest 里的 sha256 绑定。用白名单而非按扩展名排除——产物形态
# 由 kind 决定（今天是 parquet/csv/xlsx，明天还会有别的），逐个列永远列不完。
# 前导 `**/` 不能省：交付目录实际在 requests/<需求号>/deliveries/<时刻>/ 下。
# 目录要先放行，否则里面的文件再放行也没用——git 不会进被排除的目录。
**/deliveries/**/*
!**/deliveries/**/
!**/deliveries/**/manifest.json
!**/deliveries/**/README.md

# 接口探测的临时样本
.probe/

# 本地密钥与代理配置
.env

# 测试、格式化与类型检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 本机 agent 记忆（本地状态，不入库）
.workbuddy/
